 "message": "<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f4f4f4; padding: 30px; border-radius: 15px;\">\n    <div style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);\">\n        \n        <div style=\"padding: 25px; text-align: center; \n            {% if doc.workflow_state in ['Halal', 'Approved'] %} background-color: #28a745; \n            {% elif doc.workflow_state in ['Haram', 'Rejected'] %} background-color: #dc3545; \n            {% else %} background-color: #007bff; {% endif %} color: #ffffff;\">\n            \n            {% if doc.workflow_state == \"Submitted\" %}\n                <div style=\"font-size: 40px; margin-bottom: 10px;\">\ud83d\udce9</div>\n                <h2 style=\"margin: 0; text-transform: uppercase; letter-spacing: 2px;\">Query Submitted</h2>\n            {% elif doc.workflow_state in ['Halal', 'Approved'] %}\n                <div style=\"font-size: 40px; margin-bottom: 10px;\">\u2705</div>\n                <h2 style=\"margin: 0; text-transform: uppercase; letter-spacing: 2px;\">Query Approved</h2>\n            {% elif doc.workflow_state in ['Haram', 'Rejected'] %}\n                <div style=\"font-size: 40px; margin-bottom: 10px;\">\u274c</div>\n                <h2 style=\"margin: 0; text-transform: uppercase; letter-spacing: 2px;\">Query Rejected</h2>\n            {% else %}\n                <div style=\"font-size: 40px; margin-bottom: 10px;\">\ud83d\udd04</div>\n                <h2 style=\"margin: 0; text-transform: uppercase; letter-spacing: 2px;\">Status Updated</h2>\n            {% endif %}\n        </div>\n\n        <div style=\"padding: 30px; color: #444444; line-height: 1.6;\">\n            <p style=\"font-size: 16px;\"><strong>{{ doc.client_name }}</strong>,</p>\n\n            <div style=\"background-color: #f9f9f9; border: 1px solid #eeeeee; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n                <table style=\"width: 100%; border-collapse: collapse;\">\n                    <tr>\n                        <td style=\"padding: 5px 0; color: #888; font-size: 13px;\">Raw Material</td>\n                        <td style=\"padding: 5px 0; font-weight: bold; text-align: right;\">{{ doc.raw_material }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding: 5px 0; color: #888; font-size: 13px;\">Manufacturer</td>\n                        <td style=\"padding: 5px 0; font-weight: bold; text-align: right;\">{{ doc.manufacturer }}</td>\n                    </tr>\n                    <tr>\n                        <td style=\"padding: 5px 0; color: #888; font-size: 13px;\">Current Status</td>\n                        <td style=\"padding: 5px 0; font-weight: bold; text-align: right; color: #007bff;\">{{ doc.workflow_state.upper() }}</td>\n                    </tr>\n                </table>\n            </div>\n\n\n            <div style=\"text-align: center; margin-top: 30px;\">\n                <a href=\"{{ frappe.utils.get_url_to_form('Query', doc.name) }}\" \n                   style=\"background-color: #007bff; color: #ffffff; padding: 15px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;\">\n                   View in Portal\n                </a>\n            </div>\n        </div>\n\n        <div style=\"background-color: #eeeeee; padding: 20px; text-align: center; font-size: 12px; color: #777777;\">\n            <p style=\"margin: 0;\"><strong>SANHA Pakistan</strong></p>\n            <p style=\"margin: 5px 0 0 0;\">Evaluation & Research Department</p>\n            <p style=\"margin: 15px 0 0 0; border-top: 1px solid #dddddd; padding-top: 15px;\">\n                This is a secure system notification. For your security, please do not share your login credentials.\n            </p>\n        </div>\n    </div>\n</div>\n<!--<div style=\"font-family: sans-s